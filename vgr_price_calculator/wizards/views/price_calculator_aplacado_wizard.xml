<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_price_calculator_aplacado_wizard_form" model="ir.ui.view">
        <field name="name">vgr.price.calculator.aplacado.wizard.form</field>
        <field name="model">vgr.price.calculator.aplacado.wizard</field>
        <field name="arch" type="xml">
            <form string="Calculadora de Precios (Aplacado)">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" readonly="1" />
                            <field name="order_line_id" invisible="1" />
                            <field name="precio_ml" />
                        </group>
                        <group>
                            <field name="total_price_aplacado" readonly="1"
                                style="font-size: 18px; font-weight: bold; color: #000000;" />
                        </group>
                    </group>
                    <field name="aplacado_template_ids" widget="one2many_list" mode="tree" editable="bottom" domain="[('name', 'in', ['M/L Aplacado', 'Encastre enchufe', 'Intermediario'])]">
                        <tree editable="bottom" create="1" delete="1">
                            <field name="name" />
                            <field name="length" />
                            <field name="ml_measurement" string="M/L" />
                            <field name="precio_ml_individual" />
                            <field name="unit_price" string="Precio M/L Total" />
                            <field name="margin" />
                            <field name="skip_price_calculation" optional="hide" />
                            <field name="total_price" string="Precio + Margen" />
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="apply_calculated_price" string="Aplicar Precio" type="object" class="btn-primary" />
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>

