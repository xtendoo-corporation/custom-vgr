<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario -->
    <record id="view_price_group_form" model="ir.ui.view">
        <field name="name">vgr.price.group.form</field>
        <field name="model">vgr.price.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="price" widget="monetary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de árbol -->
    <record id="view_price_group_tree" model="ir.ui.view">
        <field name="name">vgr.price.group.tree</field>
        <field name="model">vgr.price.group</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_price_group" model="ir.actions.act_window">
        <field name="name">Grupos de Precios</field>
        <field name="res_model">vgr.price.group</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Elemento de menú -->
    <menuitem id="menu_price_group"
              name="Grupos de Precios"
              action="action_price_group"
              parent="stock.menu_product_in_config_stock"
              sequence="60"
    />
</odoo>
