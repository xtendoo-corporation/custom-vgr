<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_category_property_form_stock_inherit_vgr" model="ir.ui.view">
        <field name="name">product.category.form.inherit.vgr.price.calculator</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="stock_account.view_category_property_form_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_cost_method']" position="after">
                <field name="calculate_cost_by_formula_type" string="Tipo de Cálculo de Coste"/>
            </xpath>
        </field>
    </record>
</odoo>
