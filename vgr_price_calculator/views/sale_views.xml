<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_price_calculator" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.price.calculator</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
<!--            <xpath expr="//field[@name='payment_term_id']" position="after">-->
<!--                <field name="meters_linear"/>-->
<!--                <field name="price_group_id"/>-->
<!--            </xpath>-->

            <xpath expr="//field[@name='order_line']/tree" position="inside">
                <field name="needs_price_calculator" optional="hide"/>
                <button name="action_open_price_calculator"
                        string="Abrir Calculadora"
                        type="object"
                        icon="fa-calculator"
                        attrs="{'invisible': [('needs_price_calculator', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
