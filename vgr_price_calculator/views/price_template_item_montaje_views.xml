<odoo>
    <!-- Vista Tree -->
    <record id="view_price_template_item_montaje_tree" model="ir.ui.view">
        <field name="name">vgr.price.template.item.montaje.tree</field>
        <field name="model">vgr.price.template.item.montaje</field>
        <field name="arch" type="xml">
            <tree string="Plantillas de Elementos de Precio para Montaje">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_price_template_item_montaje_form" model="ir.ui.view">
        <field name="name">vgr.price.template.item.montaje.form</field>
        <field name="model">vgr.price.template.item.montaje</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Elemento de Precio para Montaje">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_price_template_item_montaje" model="ir.actions.act_window">
        <field name="name">Plantillas de Elementos de Montaje</field>
        <field name="res_model">vgr.price.template.item.montaje</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera plantilla de montaje
            </p>
        </field>
    </record>

    <!-- Elemento de menú en ajustes de ventas -->
    <menuitem id="menu_price_template_item_montaje"
              name="Plantillas de Elementos de Montaje"
              action="action_price_template_item_montaje"
              parent="sale.menu_sale_config"
              sequence="22"/>
</odoo>

