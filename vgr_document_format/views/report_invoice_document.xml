<odoo>
    <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="replace">
            <div id="informations" class="row mt-3 mb-1">
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                     t-if="o.invoice_date" name="invoice_date">
                    <t t-if="o.move_type == 'out_invoice'">
                        <strong
                            style="border: 1px solid #3a5240; padding: 5px; width: 100%; margin-bottom: 20px; background-color: rgba(58, 82, 64, 0.7);">
                            Fecha de la factura:
                        </strong>
                    </t>
                    <t t-elif="o.move_type == 'out_refund'">
                        <strong
                            style="border: 1px solid #3a5240; padding: 5px; width: 100%; margin-bottom: 20px; background-color: rgba(58, 82, 64, 0.7);">
                            Fecha de la nota de crédito:
                        </strong>
                    </t>
                    <t t-elif="o.move_type == 'out_receipt'">
                        <strong
                            style="border: 1px solid #3a5240; padding: 5px; width: 100%; margin-bottom: 20px; background-color: rgba(58, 82, 64, 0.7);">
                            Fecha del recibo:
                        </strong>
                    </t>
                    <t t-else="">
                        <strong
                            style="border: 1px solid #3a5240; padding: 5px; width: 100%; margin-bottom: 20px; background-color: rgba(58, 82, 64, 0.7);">
                            Fecha:
                        </strong>
                    </t>
                    <br/>
                    <span t-field="o.invoice_date">2023-09-12</span>
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                     t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
                    <strong
                        style="border: 1px solid #3a5240; padding: 5px; width: 100%; margin-bottom: 20px; background-color: rgba(58, 82, 64, 0.7);">
                        Fecha de vencimiento:
                    </strong>
                    <br/>
                    <span t-field="o.invoice_date_due">2023-10-31</span>
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                     t-if="o.delivery_date" name="delivery_date">
                    <strong
                        style="border: 1px solid #3a5240; padding: 5px; width: 100%; margin-bottom: 20px; background-color: rgba(58, 82, 64, 0.7);">
                        Fecha de entrega:
                    </strong>
                    <br/>
                    <span t-field="o.delivery_date">2023-09-25</span>
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                     t-if="o.invoice_origin" name="origin">
                    <strong
                        style="border: 1px solid #3a5240; padding: 5px; width: 100%; margin-bottom: 20px; background-color: rgba(58, 82, 64, 0.7);">
                        Origen:
                    </strong>
                    <br/>
                    <span t-field="o.invoice_origin">SO123</span>
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                     t-if="o.partner_id.ref" name="customer_code">
                    <strong
                        style="border: 1px solid #3a5240; padding: 5px; width: 100%; margin-bottom: 20px; background-color: rgba(58, 82, 64, 0.7);">
                        Código del cliente:
                    </strong>
                    <br/>
                    <span t-field="o.partner_id.ref"/>
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.ref"
                     name="reference">
                    <strong
                        style="border: 1px solid #3a5240; padding: 5px; width: 100%; margin-bottom: 20px; background-color: rgba(58, 82, 64, 0.7);">
                        Referencia:
                    </strong>
                    <br/>
                    <span t-field="o.ref">INV/2023/00001</span>
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
                     t-if="o.invoice_incoterm_id" name="incoterm_id">
                    <strong
                        style="border: 1px solid #3a5240; padding: 5px; width: 100%; margin-bottom: 20px; background-color: rgba(58, 82, 64, 0.7);">
                        Incoterm:
                    </strong>
                    <br/>
                    <p t-if="o.incoterm_location">
                        <span t-field="o.invoice_incoterm_id.code"/>
                        <br/>
                        <span t-field="o.incoterm_location"/>
                    </p>
                    <span t-else="" t-field="o.invoice_incoterm_id.code" class="m-0"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//thead" position="attributes">
            <attribute name="style">border: 1px solid #3a5240; padding: 5px; background-color: rgba(58, 82, 64, 0.7);
            </attribute>
        </xpath>

        <xpath expr="//table" position="after">
            <div style="border: 1px solid #3a5240; padding: 10px; width: 100%; margin-bottom: 20px; background-color: rgba(58, 82, 64, 0.7);"/>
        </xpath>

        <!-- Revertir el filtro de líneas para que procese todas las líneas -->
        <xpath expr="//t[@t-set='lines']" position="replace">
            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
        </xpath>

        <!-- Modificar el bucle para procesar todas las líneas pero solo mostrar las imprimibles -->
        <xpath expr="//t[@t-foreach='lines']" position="replace">
            <t t-foreach="lines" t-as="line">
                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                <t t-set="current_total" t-value="current_total + line.price_total"/>

                <!-- Solo mostrar la fila si la línea es imprimible -->
                <tr t-if="not line.not_printable" t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                    <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                        <td name="account_invoice_line_name"><span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">Bacon Burger</span></td>
                        <td name="td_quantity" class="text-end">
                            <span t-field="line.quantity">3.00</span>
                            <span t-field="line.product_uom_id"  groups="uom.group_uom">units</span>
                        </td>
                        <td name="td_price_unit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span class="text-nowrap" t-field="line.price_unit">9.00</span>
                        </td>
                        <td name="td_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span class="text-nowrap" t-field="line.discount">0</span>
                        </td>
                        <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                        <td name="td_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                            <span t-out="taxes" id="line_tax_ids">Tax 15%</span>
                        </td>
                        <td name="td_subtotal" class="text-end o_price_total">
                            <span class="text-nowrap" t-field="line.price_subtotal">27.00</span>
                        </td>
                    </t>
                    <t t-elif="line.display_type == 'line_section'">
                        <td colspan="99">
                            <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">A section title</span>
                        </td>
                        <t t-set="current_section" t-value="line"/>
                        <t t-set="current_subtotal" t-value="0"/>
                    </t>
                    <t t-elif="line.display_type == 'line_note'">
                        <td colspan="99">
                            <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">A note, whose content usually applies to the section or product above.</span>
                        </td>
                    </t>
                </tr>

                <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                    <tr class="is-subtotal text-end">
                        <td colspan="99">
                            <strong class="mr16">Subtotal</strong>
                            <span
                                t-out="current_subtotal"
                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                            >31.05</span>
                        </td>
                    </tr>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
