<odoo>
    <data noupdate="1">
        <!-- Grupo de usuarios que pueden modificar presupuestos -->
        <record id="group_modify_quotations" model="res.groups">
            <field name="name">Modificador de Presupuestos</field>
            <field name="category_id" ref="base.module_category_sales"/>
        </record>
        <!-- Grupo de usuarios que pueden crear productos -->
        <record id="group_create_products" model="res.groups">
            <field name="name">Creador de Productos</field>
            <field name="category_id" ref="base.module_category_inventory"/>
            <field name="comment">Usuarios con permiso para crear nuevos productos en el sistema</field>
        </record>
        <!-- Grupo de usuarios que pueden crear partners/contactos -->
        <record id="group_create_partners" model="res.groups">
            <field name="name">Creador de Contactos</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="comment">Usuarios con permiso para crear nuevos contactos en el sistema</field>
        </record>
    </data>
</odoo>
