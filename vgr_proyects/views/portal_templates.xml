<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista: Lista de proyectos en el portal -->
        <template id="portal_my_projects" name="My Projects">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Proyectos</t>
                </t>

                <div class="container mt-3">
                    <t t-if="not projects">
                        <div class="alert alert-info" role="alert">
                            <p class="mb-0">No tienes proyectos asignados.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="row">
                            <t t-foreach="projects" t-as="project">
                                <div class="col-12 col-md-6 col-lg-4 mb-4">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <a t-attf-href="/my/project/tracking/#{project.id}"
                                                   class="text-decoration-none">
                                                    <t t-esc="project.name"/>
                                                </a>
                                            </h5>
                                            <p class="card-text text-muted">
                                                <small>
                                                    <i class="fa fa-tasks"/>
                                                    <t t-esc="project.task_count"/>
                                                    tareas
                                                </small>
                                            </p>
                                            <t t-if="project.stage_id and not project.stage_id.hide_in_portal">
                                                <span class="badge bg-info">
                                                    <t t-esc="project.stage_id.name"/>
                                                </span>
                                            </t>
                                        </div>
                                        <div class="card-footer bg-transparent">
                                            <a t-attf-href="/my/project/tracking/#{project.id}"
                                               class="btn btn-primary btn-sm w-100">
                                                <i class="fa fa-eye"/>
                                                Ver Proyecto
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <div t-if="pager" class="o_portal_pager text-center">
                            <t t-call="portal.pager"/>
                        </div>
                    </t>
                </div>
            </t>
        </template>

        <!-- Vista: Detalle de proyecto con tracking de etapas -->
        <template id="portal_my_project" name="My Project">
            <t t-call="portal.portal_layout">
                <style>
                    /* Estilos para el tracking de proyectos */
                    .project-tracking-container {
                        background: linear-gradient(135deg, #3e5451 0%, #2a3b38 100%);
                        border-radius: 12px;
                        padding: 25px;
                        margin: 20px auto;
                        max-width: 600px;
                        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
                    }

                    .tracking-header {
                        text-align: center;
                        margin-bottom: 25px;
                    }

                    .tracking-icon {
                        font-size: 40px;
                        color: #a8d5ba;
                        margin-bottom: 10px;
                    }

                    .tracking-title {
                        color: #ffffff;
                        font-size: 24px;
                        font-weight: bold;
                        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
                        margin: 0;
                    }

                    .project-stage-tracker-vertical {
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        padding: 20px 0;
                    }

                    .stage-vertical-item {
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        width: 100%;
                        max-width: 380px;
                        margin: 8px 0;
                        z-index: 2;
                    }

                    .stage-content-box {
                        background: white;
                        border-radius: 10px;
                        padding: 18px 25px;
                        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
                        transition: all 0.3s ease;
                        width: 100%;
                        border: 3px solid #d0d0d0;
                    }

                    .stage-vertical-item.current .stage-content-box {
                        background: linear-gradient(135deg, #3e5451 0%, #567d6e 100%);
                        border-color: #a8d5ba;
                        border-width: 5px;
                        transform: scale(1.15);
                        box-shadow: 0 15px 40px rgba(62, 84, 81, 0.7), 0 0 30px rgba(168, 213, 186, 0.5);
                        animation: pulse-current 2s ease-in-out infinite;
                    }

                    @keyframes pulse-current {
                        0%, 100% {
                            box-shadow: 0 15px 40px rgba(62, 84, 81, 0.7), 0 0 30px rgba(168, 213, 186, 0.5);
                        }
                        50% {
                            box-shadow: 0 15px 40px rgba(62, 84, 81, 0.7), 0 0 40px rgba(168, 213, 186, 0.8);
                        }
                    }

                    .stage-vertical-item.current .stage-name {
                        color: white;
                        font-weight: bold;
                        font-size: 20px;
                        text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.5);
                    }

                    .stage-vertical-item.completed .stage-content-box {
                        background: linear-gradient(135deg, #6b9080 0%, #a4c3b2 100%);
                        border-color: #6b9080;
                        opacity: 0.6;
                    }

                    .stage-vertical-item.completed .stage-name {
                        color: white;
                    }

                    .stage-vertical-item.completed:hover .stage-content-box {
                        opacity: 0.75;
                    }

                    .stage-vertical-item.pending .stage-content-box {
                        background: #f5f5f5;
                        border-color: #d0d0d0;
                        opacity: 0.7;
                    }

                    .stage-vertical-item.pending .stage-name {
                        color: #6c757d;
                    }

                    .stage-vertical-item:hover .stage-content-box {
                        transform: translateY(-4px) scale(1.03);
                        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
                    }

                    .stage-name {
                        font-size: 18px;
                        font-weight: 600;
                        text-align: center;
                        line-height: 1.3;
                    }

                    .stage-connector-vertical {
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        margin: 3px 0;
                        z-index: 1;
                    }

                    .connector-line {
                        font-size: 28px;
                        line-height: 0.8;
                        font-weight: bold;
                        color: #a8d5ba;
                        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
                    }

                    .stage-connector-vertical.completed .connector-line {
                        color: #a4c3b2;
                        opacity: 0.6;
                    }

                    .stage-connector-vertical.current .connector-line {
                        color: #d4f1e6;
                        font-size: 32px;
                        font-weight: 900;
                        text-shadow: 2px 2px 8px rgba(168, 213, 186, 0.8);
                    }

                    .stage-connector-vertical.pending .connector-line {
                        color: #8a9a96;
                        opacity: 0.5;
                    }

                    .tracking-footer {
                        margin-top: 30px;
                        text-align: center;
                    }

                    .current-stage-highlight {
                        background: white;
                        border-radius: 10px;
                        padding: 20px;
                        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
                        border: 3px solid #a8d5ba;
                    }

                    .highlight-label {
                        font-size: 16px;
                        color: #3e5451;
                        font-weight: 600;
                        text-transform: uppercase;
                    }

                    .highlight-stage {
                        font-size: 28px;
                        font-weight: bold;
                        color: #3e5451;
                        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
                    }

                    .project-info-card {
                        background: white;
                        border-radius: 12px;
                        padding: 25px;
                        margin-bottom: 25px;
                        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
                        border-left: 5px solid #3e5451;
                    }

                    .project-info-card h2 {
                        font-size: 26px;
                        font-weight: bold;
                        color: #2c3e50;
                    }

                    .project-info-card p {
                        font-size: 16px;
                        color: #34495e;
                    }

                    @media (max-width: 768px) {
                        .project-tracking-container { max-width: 100%; padding: 20px; }
                        .tracking-title { font-size: 20px; }
                        .stage-name { font-size: 16px; }
                        .connector-line { font-size: 24px; }
                        .highlight-stage { font-size: 24px; }
                        .stage-vertical-item { max-width: 100%; }
                    }
                </style>

                <div class="container mt-4">
                    <!-- Información del Proyecto -->
                    <div class="project-info-card">
                        <div class="row">
                            <div class="col-12">
                                <h2 class="mb-3">
                                    <i class="fa fa-folder-open text-primary"/>
                                    <t t-esc="project.name"/>
                                </h2>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-2">
                                    <strong>Cliente:</strong>
                                    <t t-esc="project.customer_name or project.partner_id.name"/>
                                </p>
                                <p class="mb-2" t-if="project.date">
                                    <strong>Fecha de Inicio:</strong>
                                    <t t-esc="project.date" t-options='{"widget": "date"}'/>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Tracking de Etapas Ultra Mejorado -->
                    <div class="project-tracking-container">
                        <!-- Header del Tracking -->
                        <div class="tracking-header">
                            <div class="tracking-icon">
                                <i class="fa fa-rocket"/>
                            </div>
                            <h3 class="tracking-title">Seguimiento del Proyecto</h3>
                        </div>

                        <!-- Timeline de Etapas VERTICAL -->
                        <t t-set="visible_stages" t-value="[s for s in stage_info.get('stages', []) if not s.get('hide_in_portal')]"/>
                        <div class="project-stage-tracker-vertical">
                            <t t-foreach="visible_stages" t-as="stage">
                                <!-- Etapa -->
                                <div t-attf-class="stage-vertical-item #{stage.get('status', '')}">
                                    <div class="stage-content-box">
                                        <div class="stage-name">
                                            <t t-esc="stage.get('name', '')"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Línea conectora vertical "|" -->
                                <t t-if="not stage_last">
                                    <div t-attf-class="stage-connector-vertical #{stage.get('status', '')}">
                                        <div class="connector-line">    ↓</div>
                                        <div class="connector-line">    |</div>
                                        <div class="connector-line">    |</div>
                                        <div class="connector-line">    |</div>
                                        <div class="connector-line">    ↓</div>
                                    </div>
                                </t>
                            </t>
                        </div>


                        <!-- Footer con Estado Actual Destacado -->
                        <div class="tracking-footer">
                            <div class="current-stage-highlight">
                                <div class="highlight-content">
                                    <br/><br/>
                                    <span class="highlight-label">Estado Actual del Proyecto</span>
                                    <h2 class="highlight-stage">
                                        <t t-esc="stage_info.get('current_stage', 'En proceso')"/>
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botón volver -->
                    <div class="text-center mt-5 mb-5">
                        <a href="/my/projects" class="btn btn-lg btn-outline-secondary">
                            <i class="fa fa-arrow-left"/>
                            Volver a Mis Proyectos
                        </a>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
