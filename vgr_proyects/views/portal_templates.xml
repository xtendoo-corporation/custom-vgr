<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista: Lista de proyectos en el portal -->
        <template id="portal_my_projects" name="My Projects">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Proyectos</t>
                </t>

                <div class="container mt-3">
                    <t t-if="not projects">
                        <div class="alert alert-info" role="alert">
                            <p class="mb-0">No tienes proyectos asignados.</p>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="row">
                            <t t-foreach="projects" t-as="project">
                                <div class="col-12 col-md-6 col-lg-4 mb-4">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <a t-attf-href="/my/project/tracking/#{project.id}"
                                                   class="text-decoration-none">
                                                    <t t-esc="project.name"/>
                                                </a>
                                            </h5>
                                            <p class="card-text text-muted">
                                                <small>
                                                    <i class="fa fa-tasks"/>
                                                    <t t-esc="project.task_count"/>
                                                    tareas
                                                </small>
                                            </p>
                                            <t t-if="project.stage_id and not project.stage_id.hide_in_portal">
                                                <span class="badge bg-info">
                                                    <t t-esc="project.stage_id.name"/>
                                                </span>
                                            </t>
                                        </div>
                                        <div class="card-footer bg-transparent">
                                            <a t-attf-href="/my/project/tracking/#{project.id}"
                                               class="btn btn-primary btn-sm w-100">
                                                <i class="fa fa-eye"/>
                                                Ver Proyecto
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <div t-if="pager" class="o_portal_pager text-center">
                            <t t-call="portal.pager"/>
                        </div>
                    </t>
                </div>
            </t>
        </template>

        <!-- Vista: Detalle de proyecto con tracking de etapas -->
        <template id="portal_my_project" name="My Project">
            <t t-call="portal.portal_layout">
                <style>
                    /* Estilos para el tracking de proyectos */
                    .project-tracking-container {
                        background: #ffffff;
                        border-radius: 12px;
                        padding: 40px;
                        margin: 20px auto;
                        max-width: 1400px;
                        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
                        border: 2px solid #e0e0e0;
                    }

                    .tracking-header {
                        text-align: center;
                        margin-bottom: 40px;
                    }

                    .tracking-icon {
                        font-size: 40px;
                        color: #3e5451;
                        margin-bottom: 10px;
                    }

                    .tracking-title {
                        color: #3e5451;
                        font-size: 28px;
                        font-weight: bold;
                        margin: 0;
                    }

                    .project-stage-tracker-vertical {
                        position: relative;
                        padding: 30px 0 30px 100px;
                        margin: 0 auto;
                        max-width: 1100px;
                    }

                    /* Línea vertical gruesa */
                    .project-stage-tracker-vertical::before {
                        content: '';
                        position: absolute;
                        left: 50px;
                        top: 30px;
                        bottom: 30px;
                        width: 8px;
                        background: linear-gradient(to bottom, #a8d5ba 0%, #6b9080 100%);
                        border-radius: 4px;
                    }

                    .stage-vertical-item {
                        position: relative;
                        display: flex;
                        align-items: center;
                        margin-bottom: 60px;
                        min-height: 60px;
                    }

                    .stage-vertical-item:last-child {
                        margin-bottom: 0;
                    }

                    /* Punto/círculo de la etapa */
                    .stage-point {
                        position: absolute;
                        left: -58px;
                        width: 28px;
                        height: 28px;
                        border-radius: 50%;
                        background: #fff;
                        border: 5px solid #d0d0d0;
                        z-index: 2;
                        transition: all 0.3s ease;
                    }

                    /* Contenido de la etapa (nombre a la derecha) - SIN FONDO */
                    .stage-content-box {
                        background: transparent;
                        padding: 10px 20px;
                        transition: all 0.3s ease;
                        width: 100%;
                        margin-left: 30px;
                        border: none;
                        box-shadow: none;
                    }

                    .stage-name {
                        font-size: 24px;
                        font-weight: 600;
                        line-height: 1.4;
                        color: #2c3e50;
                    }

                    /* Etapa actual */
                    .stage-vertical-item.current .stage-point {
                        width: 40px;
                        height: 40px;
                        left: -64px;
                        background: linear-gradient(135deg, #3e5451 0%, #567d6e 100%);
                        border: 6px solid #a8d5ba;
                        box-shadow: 0 0 0 10px rgba(168, 213, 186, 0.3),
                                    0 5px 25px rgba(62, 84, 81, 0.6);
                        animation: pulse-point 2s ease-in-out infinite;
                    }

                    @keyframes pulse-point {
                        0%, 100% {
                            box-shadow: 0 0 0 10px rgba(168, 213, 186, 0.3),
                                        0 5px 25px rgba(62, 84, 81, 0.6);
                        }
                        50% {
                            box-shadow: 0 0 0 15px rgba(168, 213, 186, 0.2),
                                        0 5px 30px rgba(62, 84, 81, 0.8);
                        }
                    }

                    .stage-vertical-item.current .stage-content-box {
                        background: transparent;
                        border: none;
                        transform: scale(1.1);
                    }

                    .stage-vertical-item.current .stage-name {
                        color: #3e5451;
                        font-weight: bold;
                        font-size: 28px;
                        text-shadow: 2px 2px 4px rgba(62, 84, 81, 0.2);
                    }

                    /* Etapa completada */
                    .stage-vertical-item.completed .stage-point {
                        background: linear-gradient(135deg, #6b9080 0%, #a4c3b2 100%);
                        border-color: #6b9080;
                    }

                    .stage-vertical-item.completed .stage-content-box {
                        background: transparent;
                        border: none;
                        opacity: 0.6;
                    }

                    .stage-vertical-item.completed .stage-name {
                        color: #6b9080;
                    }

                    .stage-vertical-item.completed:hover .stage-content-box {
                        opacity: 0.8;
                    }

                    /* Etapa pendiente */
                    .stage-vertical-item.pending .stage-point {
                        background: #f5f5f5;
                        border-color: #d0d0d0;
                    }

                    .stage-vertical-item.pending .stage-content-box {
                        background: transparent;
                        border: none;
                        opacity: 0.5;
                    }

                    .stage-vertical-item.pending .stage-name {
                        color: #6c757d;
                    }

                    .stage-vertical-item:hover .stage-content-box {
                        transform: translateX(10px);
                    }

                    .stage-vertical-item.current:hover .stage-content-box {
                        transform: translateX(10px) scale(1.1);
                    }

                    .tracking-footer {
                        margin-top: 40px;
                        text-align: center;
                    }

                    .current-stage-highlight {
                        background: white;
                        border-radius: 12px;
                        padding: 25px;
                        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
                        border: 3px solid #a8d5ba;
                    }

                    .highlight-label {
                        font-size: 16px;
                        color: #3e5451;
                        font-weight: 600;
                        text-transform: uppercase;
                    }

                    .highlight-stage {
                        font-size: 30px;
                        font-weight: bold;
                        color: #3e5451;
                        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
                        margin-top: 10px;
                    }

                    .project-info-card {
                        background: white;
                        border-radius: 12px;
                        padding: 30px;
                        margin-bottom: 30px;
                        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
                        border-left: 5px solid #3e5451;
                    }

                    .project-info-card h2 {
                        font-size: 28px;
                        font-weight: bold;
                        color: #2c3e50;
                    }

                    .project-info-card p {
                        font-size: 16px;
                        color: #34495e;
                    }

                    @media (max-width: 768px) {
                        .project-tracking-container {
                            max-width: 100%;
                            padding: 25px 15px;
                        }
                        .tracking-title { font-size: 24px; }
                        .stage-name { font-size: 20px; }
                        .stage-vertical-item.current .stage-name { font-size: 24px; }
                        .highlight-stage { font-size: 26px; }
                        .project-stage-tracker-vertical {
                            padding-left: 80px;
                        }
                        .project-stage-tracker-vertical::before {
                            left: 35px;
                        }
                        .stage-point {
                            left: -48px;
                        }
                        .stage-vertical-item.current .stage-point {
                            left: -54px;
                        }
                    }
                </style>

                <div class="container mt-4">
                    <!-- Información del Proyecto -->
                    <div class="project-info-card">
                        <div class="row">
                            <div class="col-12">
                                <h2 class="mb-3">
                                    <i class="fa fa-folder-open text-primary"/>
                                    <t t-esc="project.name"/>
                                </h2>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-2">
                                    <strong>Cliente:</strong>
                                    <t t-esc="project.customer_name or project.partner_id.name"/>
                                </p>
                                <p class="mb-2" t-if="project.date">
                                    <strong>Fecha de Inicio:</strong>
                                    <t t-esc="project.date" t-options='{"widget": "date"}'/>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Tracking de Etapas Ultra Mejorado -->
                    <div class="project-tracking-container">
                        <!-- Header del Tracking -->
                        <div class="tracking-header">
                            <div class="tracking-icon">
                                <i class="fa fa-rocket"/>
                            </div>
                            <h3 class="tracking-title">Seguimiento del Proyecto</h3>
                        </div>

                        <!-- Timeline de Etapas VERTICAL -->
                        <t t-set="visible_stages" t-value="[s for s in stage_info.get('stages', []) if not s.get('hide_in_portal')]"/>
                        <div class="project-stage-tracker-vertical">
                            <t t-foreach="visible_stages" t-as="stage">
                                <!-- Etapa con punto y nombre a la derecha -->
                                <div t-attf-class="stage-vertical-item #{stage.get('status', '')}">
                                    <!-- Punto/círculo de la etapa -->
                                    <div class="stage-point"></div>

                                    <!-- Contenido de la etapa (nombre a la derecha) -->
                                    <div class="stage-content-box">
                                        <div class="stage-name">
                                            <t t-esc="stage.get('name', '')"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>


                        <!-- Footer con Estado Actual Destacado -->
                        <div class="tracking-footer">
                            <div class="current-stage-highlight">
                                <div class="highlight-content">
                                    <br/>
                                    <span class="highlight-label">Estado Actual del Proyecto</span>
                                    <h2 class="highlight-stage">
                                        <t t-esc="stage_info.get('current_stage', 'En proceso')"/>
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botón volver -->
                    <div class="text-center mt-5 mb-5">
                        <a href="/my/projects" class="btn btn-lg btn-outline-secondary">
                            <i class="fa fa-arrow-left"/>
                            Volver a Mis Proyectos
                        </a>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
