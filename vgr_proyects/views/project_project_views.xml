<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_project_form_inherit_vgr" model="ir.ui.view">
            <field name="name">project.project.form.inherit.vgr</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="customer_name" string="Nombre" required="1"/>
                    <field name="customer_phone" string="Teléfono" required="1"/>
                    <field name="customer_address" string="Dirección" required="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
