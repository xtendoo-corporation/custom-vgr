<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Herencia de la vista formulario -->
        <record id="view_task_form2_inherit" model="ir.ui.view">
            <field name="name">project.task.form.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='date_deadline_and_recurring_task']" position="after">
                    <label for="execution_date"/>
                    <div class="d-inline-flex w-100">
                        <field name="execution_date" nolabel="1" widget="datetime"/>
                    </div>
                    <label for="related_contact_id"/>
                    <div class="d-inline-flex w-100">
                        <field name="related_contact_id" nolabel="1" options="{'no_create': True, 'no_open': True}"/>
                    </div>
                    <label for="project_state_on_completion"/>
                    <div class="d-inline-flex w-100">
                        <field name="project_state_on_completion" nolabel="1" options="{'no_create': True, 'no_open': True}" placeholder="Seleccionar estado del proyecto..."/>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- Herencia de la vista kanban -->
        <record id="view_task_kanban_inherit" model="ir.ui.view">
            <field name="name">project.task.kanban.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_kanban"/>
            <field name="arch" type="xml">
                <!-- Asegurar que los campos personalizados estén disponibles -->
                <field name="color" position="after">
                    <field name="execution_date"/>
                </field>

                <xpath expr="//div[@name='date_deadline']" position="replace">
                    <div t-if="record.date_deadline.raw_value" name="date_deadline"  class="text-muted">
                        <i class="fa fa-calendar me-1" title="Fecha límite"/>
                        <strong>Límite: </strong>
                        <field name="date_deadline" widget="date"/>
                        <span class="text-muted"> (<t t-esc="Math.ceil((new Date(record.date_deadline.raw_value) - new Date(new Date(record.date_deadline.raw_value).getFullYear(), 0, 1) + 86400000) / 604800000)"/>)</span>
                    </div>
                    <div t-if="record.execution_date.raw_value" class="text-muted mt-1">
                        <i class="fa fa-clock-o me-1" title="Fecha de realización"/>
                        <strong>Realización: </strong>
                        <field name="execution_date" widget="date"/>
                        <span class="text-muted"> (<t t-esc="Math.ceil((new Date(record.execution_date.raw_value) - new Date(new Date(record.execution_date.raw_value).getFullYear(), 0, 1) + 86400000) / 604800000)"/>)</span>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- Herencia de la vista calendario -->
        <record id="view_task_calendar_inherit" model="ir.ui.view">
            <field name="name">project.task.calendar.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_calendar"/>
            <field name="arch" type="xml">
                <!-- Agregar el campo calendar_color después del último campo existente -->
                <field name="task_properties" position="after">
                    <field name="calendar_color"/>
                </field>

                <!-- Cambiar solo el atributo color del calendario -->
                <calendar position="attributes">
                    <attribute name="color">calendar_color</attribute>
                </calendar>
            </field>
        </record>
    </data>
</odoo>
