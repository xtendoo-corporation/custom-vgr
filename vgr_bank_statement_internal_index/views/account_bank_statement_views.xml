<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista tree personalizada para las líneas del bank statement -->
    <record id="view_bank_statement_line_tree_internal_index" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.internal.index</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="1" delete="1">
                <field name="sequence"/>
                <field name="internal_index" optional="hide"/>
                <field name="date"/>
                <field name="payment_ref" string="Label"/>
                <field name="partner_id"/>
                <field name="amount" sum="Total"/>
                <field name="running_balance" string="Saldo"/>
                <button name="action_undo_reconciliation" type="object" icon="fa-undo" title="Deshacer Conciliación" string="Revertir la conciliación" invisible="not is_reconciled"/>
                <button name="action_open_journal_entry" type="object" icon="fa-folder" title="Ver Entradas del Diario"/>
                <field name="is_reconciled" invisible="1" column_invisible="1"/>
                <field name="suitable_journal_ids" invisible="1" column_invisible="1"/>
                <field name="journal_id" invisible="1" column_invisible="1"/>
                <field name="company_id" invisible="1" column_invisible="1"/>
                <field name="currency_id" invisible="1" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Heredar la vista de formulario del bank statement para usar nuestra vista y añadir botones -->
    <record id="view_bank_statement_form_internal_index" model="ir.ui.view">
        <field name="name">account.bank.statement.form.internal.index</field>
        <field name="model">account.bank.statement</field>
        <field name="inherit_id" ref="account_statement_base.view_bank_statement_form"/>
        <field name="arch" type="xml">
            <!-- Usar nuestra vista tree personalizada para las líneas -->
            <xpath expr="//field[@name='line_ids']" position="attributes">
                <attribute name="context">{'default_journal_id': journal_id, 'tree_view_ref': 'vgr_bank_statement_internal_index.view_bank_statement_line_tree_internal_index'}</attribute>
            </xpath>

            <!-- Añadir botones en el header -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_vgr_recalculate_sequences"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-sort-numeric-asc"
                        string="Recalcular Secuencias"
                        help="Recalcula las secuencias basándose en la fecha"/>
                <button name="action_vgr_recalculate_internal_index"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-refresh"
                        string="Recalcular Índices"
                        help="Fuerza el recálculo del internal_index de todas las líneas"/>
                <button name="action_vgr_recalculate_running_balance"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calculator"
                        string="Recalcular Running Balance"
                        help="Recalcula el balance de todas las líneas"/>
                <button name="action_vgr_delete_lines"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-trash"
                        string="Borrar Líneas Vacías"
                        help="Elimina líneas que no tienen statement_id"/>
            </xpath>
        </field>
    </record>

</odoo>

